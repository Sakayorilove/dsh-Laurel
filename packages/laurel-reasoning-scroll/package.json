{
  "name": "laurel-reasoning-scroll",
  "version": "0.1.1",
  "description": "思考过程滚动窗：把会话里「思考」的展开体换成限高 240px、渐变淡出、流式贴底的滚动窗，可把工具过程一并并进来。作为 Laurel 套件的独立模块。",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "locale/*.json",
    "icon.svg"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "reasoning",
    "scroll",
    "laurel"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.2.1-rc.1"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs --entry lib/client/index.mjs --out lib/client.js --id laurel-reasoning-scroll --strip-comments",
    "build:check": "node scripts/build-client.mjs --entry lib/client/index.mjs --out lib/client.js --id laurel-reasoning-scroll --strip-comments --check"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "private": true
}
